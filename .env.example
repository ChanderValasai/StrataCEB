# ==============================================================================
# Lime Stone (Eco-Earth Block) Environment Variables
# ==============================================================================

# PostgreSQL Connection String (REQUIRED on Vercel with Neon or Supabase)
# Examples:
#   Neon:     postgresql://neondb_owner:PASSWORD@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
#   Supabase: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Canonical public website URL (recommended on Vercel Production)
APP_URL="https://limestone.villothar.com"

# Optional: Max Postgres pool connections per serverless instance (default: 5 when DATABASE_URL is set)
PG_POOL_MAX="5"

# Optional: Set to "false" ONLY for local non-SSL Postgres testing
# DATABASE_SSL="false"

# Optional: Gemini API Key (only needed if AI features are enabled server-side)
GEMINI_API_KEY=""

# ==============================================================================
# Legacy / Google AI Studio Cloud SQL Preview Variables (NOT used when DATABASE_URL is set)
# ==============================================================================
# SQL_HOST=""
# SQL_USER=""
# SQL_PASSWORD=""
# SQL_DB_NAME=""
