# ==============================================================================
# Lime Stone (Eco-Earth Block) — Local Development Environment (.env)
# Copy this file to `.env` for local development:  cp .env.example .env
# ==============================================================================

# Local PostgreSQL Connection String (SSL is automatically disabled on localhost)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/limestone"

# Max Postgres connection pool size (read by src/db/index.ts)
PG_POOL_MAX="10"

# Explicitly disable SSL for local PostgreSQL ("false" locally; omit/remove for Neon/Supabase)
DATABASE_SSL="false"

# Local development URL (set to "https://limestone.villothar.com" on Vercel Production)
APP_URL="http://localhost:3000"

# Optional: Gemini API Key (only needed if AI features are enabled server-side)
GEMINI_API_KEY=""

# ==============================================================================
# Hosted PostgreSQL (Vercel Production) — Switch without code changes!
# On Vercel, set DATABASE_URL (and optionally PG_POOL_MAX="5", APP_URL="https://limestone.villothar.com")
# and omit DATABASE_SSL (SSL is enabled automatically for non-localhost URLs).
#
#   Neon:     DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"
#   Supabase: DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"
# ==============================================================================
